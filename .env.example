# Copy this file to .env and fill in real values.

DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin panel (/admin) — required to enable admin login at all.
ADMIN_PASSWORD="change-me"

# MSG91 (optional). Leave unset to keep OTP in dev mode (code shown on-screen
# in the login modal instead of being texted). Get these from msg91.com after
# creating an OTP template.
# MSG91_AUTH_KEY=""
# MSG91_OTP_TEMPLATE_ID=""
# MSG91_SENDER_ID="JGHLAB"

# Anthropic (optional). Leave unset and the chat widget still works, using a
# built-in keyword-matched responder. Set this to switch it to real
# Claude-powered answers. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=""

# WhatsApp Cloud API (optional). Leave unset and the site's WhatsApp button
# still works as a plain click-to-chat wa.me link. Set these to enable real
# two-way automation — an incoming WhatsApp message gets an instant
# Claude-powered reply (same brain as the site chat), and admins can take
# over any conversation from /admin/whatsapp. Get these from a Meta app at
# developers.facebook.com (WhatsApp product) — see README for setup steps.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""

# Cron secret (optional but recommended once you wire up a scheduler).
# Protects GET /api/cron/pickup-reminders, which sends the T-30-min "your
# phlebotomist is X, call Y" WhatsApp notice — nothing calls this route on
# its own, since Next.js has no built-in scheduler. Point an external
# scheduler (Vercel Cron, an OS cron job, etc.) at
# /api/cron/pickup-reminders?secret=<this value> every 5-15 minutes. Leave
# unset only for local testing — the route stays open with no secret set.
# CRON_SECRET=""

# Razorpay (optional). Leave unset and checkout works exactly as before —
# pay cash to the phlebotomist on collection. Set both to add a "Pay online
# now" button on the booking confirmation page, via Razorpay's standard
# Checkout widget (covers cards, UPI, netbanking and wallets in one
# integration). Get test-mode keys at dashboard.razorpay.com.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
